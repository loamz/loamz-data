# Python here is only the embeddable engine. Run: uv run lint-imports --config .importlinter
# The engine imports no server, no client and no agent runtime.
[importlinter]
root_packages =
    loamz
include_external_packages = False
exclude_type_checking_imports = True

[importlinter:contract:engine-is-self-contained]
name = the engine imports no server, client or agent runtime
type = forbidden
source_modules =
    loamz.engine
forbidden_modules =
    loamz.server
    loamz.data
    loamz.runtime
