{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "publicUrls"
  ],
  "properties": {
    "publicUrls": {
      "type": "object",
      "required": [
        "keycloak",
        "dataWeb",
        "dataApi"
      ],
      "properties": {
        "keycloak": {
          "type": "string",
          "pattern": "^https?://"
        },
        "dataWeb": {
          "type": "string",
          "pattern": "^https?://"
        },
        "dataApi": {
          "type": "string",
          "pattern": "^https?://"
        },
        "s3": {
          "type": "string"
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "external": {
          "type": "object",
          "properties": {
            "sslmode": {
              "enum": [
                "require",
                "verify-ca",
                "verify-full"
              ]
            }
          }
        }
      }
    }
  }
}
