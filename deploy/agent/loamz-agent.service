[Unit]
Description=Loamz Compute Agent
Documentation=https://data.loamz.com/docs/connect/compute
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/loamz-agent/env
ExecStart=/opt/loamz-agent/bin/loamz-runner agent
Restart=on-failure
RestartSec=3s
LimitNOFILE=65536
WorkingDirectory=/opt/loamz-agent
# No new privileges restriction relaxed as required by gVisor sandbox transitions
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
