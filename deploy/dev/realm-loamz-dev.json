{
  "realm": "loamz",
  "displayName": "Loamz",
  "loginTheme": "loamz",
  "enabled": true,
  "sslRequired": "none",
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 7776000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ENABLED\"}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "loamz-chat",
      "name": "Loamz Chat",
      "description": "The chat web app: public client, authorization code + PKCE (S256).",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "picture",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "picture",
            "claim.name": "picture",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "loamz-chat audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "loamz-chat",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "organization"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "loamz-data",
      "name": "Loamz Data",
      "description": "The Data web app and API: public client, authorization code + PKCE (S256). Tokens carry the organization (its alias, which Keycloak never lets anyone change), the person's groups, and the client role account-admin.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:5180",
      "redirectUris": [
        "http://localhost:5180/*"
      ],
      "webOrigins": [
        "http://localhost:5180"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5180/*"
      },
      "protocolMappers": [
        {
          "name": "loamz-data audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "loamz-data",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "organization"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "loamz-data-directory",
      "name": "Loamz Data directory",
      "description": "Lets Data list people and groups and create organizations and people for its admin pages. A service account.",
      "enabled": true,
      "publicClient": false,
      "secret": "${LOAMZ_DATA_DIRECTORY_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "loamz-data-test",
      "name": "Loamz Data test (development only)",
      "description": "Lets test scripts get real tokens for test users with a password. Exists only in the throwaway development realm.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "loamz-data audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "loamz-data",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "email",
        "organization"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "loamz-openbao",
      "name": "OpenBao (development)",
      "enabled": true,
      "publicClient": false,
      "secret": "openbao-dev-only",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8200/ui/vault/auth/oidc/oidc/callback",
        "http://localhost:8200/ui/vault/auth/oidc/oidc/callback",
        "http://localhost:8250/oidc/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "roles from the client's roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "loamz-openbao",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "loamz-rustfs",
      "name": "RustFS console (development)",
      "enabled": true,
      "publicClient": false,
      "secret": "rustfs-dev-only",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:9001/*",
        "http://localhost:9001/*",
        "http://127.0.0.1:9000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "policy from the client's roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "loamz-rustfs",
            "claim.name": "policy",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "loamz-data": [
        {
          "name": "account-admin",
          "description": "May manage this account in Loamz Data: workspaces, identities, catalogs, compute, usage."
        },
        {
          "name": "platform-admin",
          "description": "The installation's admin: creates organizations and adds people to them."
        }
      ],
      "loamz-openbao": [
        {
          "name": "admin",
          "description": "May sign in to OpenBao with full access (development)."
        }
      ],
      "loamz-rustfs": [
        {
          "name": "consoleAdmin",
          "description": "May sign in to the RustFS console with full access (development)."
        }
      ]
    }
  },
  "users": [
    {
      "username": "service-account-loamz-data-directory",
      "enabled": true,
      "serviceAccountClientId": "loamz-data-directory",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "query-groups",
          "view-realm",
          "manage-users",
          "manage-realm"
        ]
      }
    },
    {
      "username": "admin",
      "email": "admin@loamz.local",
      "firstName": "Loamz",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": true
        }
      ],
      "clientRoles": {
        "loamz-data": [
          "platform-admin"
        ],
        "loamz-openbao": [
          "admin"
        ],
        "loamz-rustfs": [
          "consoleAdmin"
        ]
      }
    }
  ],
  "identityProviders": []
}
